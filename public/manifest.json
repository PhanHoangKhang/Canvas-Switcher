
{
  "manifest_version": 3,
  "name": "Canvas Switcher",
  "version": "0.1.0",
  "description": "Navigate Canvas courses and resources faster.",
  "permissions": [
    "sidePanel",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.instructure.com/*"
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open Canvas Switcher"
  },
  "background": {
    "service_worker": "background.js"
  }
}
